# ==============================================================================
# .gitignore — Proyek Website Kejutan Joice Omasi Angelita Harefa
# ==============================================================================

# Dependencies
node_modules/
app/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
.next/
app/.next/
out/
app/out/
build/
app/build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts
app/next-env.d.ts

# Environment Variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel/
app/.vercel/

# Debug & Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw?

# Security & Keys
*.pem
*.key
*.cert

